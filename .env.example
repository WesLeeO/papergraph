# Copy to .env (`cp .env.example .env`). .env is gitignored; never commit real keys.

# Optional, not needed to run PaperGraph (the agent uses a free local model).
ANTHROPIC_API_KEY=

POSTGRES_USER=papergraph
POSTGRES_PASSWORD=papergraph
POSTGRES_DB=papergraph

# Host port for Postgres. Change both lines if 5432 is already in use.
DB_PORT=5432
# Used when running Python on the host (outside Docker).
DATABASE_URL=postgresql://papergraph:papergraph@localhost:5432/papergraph
